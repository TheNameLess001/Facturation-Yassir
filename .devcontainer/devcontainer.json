{
  "name": "CashCo V2",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": {"label": "CashCo Streamlit", "onAutoForward": "openPreview"}
  },
  "postCreateCommand": "python -m pip install -r requirements.txt",
  "remoteEnv": {
    "GOOGLE_SERVICE_ACCOUNT_JSON": "${localEnv:GOOGLE_SERVICE_ACCOUNT_JSON}"
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff"]
    }
  }
}
