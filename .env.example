CASHCO_ENV=development
CASHCO_APP_TITLE=CashCo
CASHCO_DEFAULT_USER_ID=admin.demo
CASHCO_DEFAULT_USER_NAME=Demo Admin
CASHCO_DEFAULT_USER_EMAIL=admin@example.com
CASHCO_DEFAULT_USER_ROLE=ADMIN
CASHCO_CURRENCY=MAD
CASHCO_TIMEZONE=Africa/Casablanca
# Optional JSON override for settlement status/cancellation rules.
CASHCO_SETTLEMENT_RULES={}
GOOGLE_SERVICE_ACCOUNT_JSON=
CASHCO_ADMIN_EARNINGS_FOLDER_ID=
CASHCO_INVOICE_SCOPE_FILE_ID=
# Active worksheet in the Invoice Scope workbook. Other worksheets are profiled only.
CASHCO_INVOICE_SCOPE_WORKSHEET=CASH-CO
# Optional JSON mapping for exact source headers.
CASHCO_INVOICE_SCOPE_COLUMN_MAP={}
# Optional JSON object mapping canonical fields to exact source column names.
CASHCO_ADMIN_EARNINGS_COLUMN_MAP={}
CASHCO_ADMIN_EARNINGS_MAX_FILE_MB=100
CASHCO_ADMIN_EARNINGS_DATE_DAY_FIRST=false
CASHCO_ADMIN_EARNINGS_CSV_ENCODING=utf-8-sig
CASHCO_RST_LIST_FILE_ID=
CASHCO_RST_LIST_FOLDER_ID=
CASHCO_RST_COLUMN_MAP={}
CASHCO_RST_MAX_FILE_MB=50
CASHCO_RST_CSV_ENCODING=utf-8-sig
CASHCO_RESTAURANT_REGISTRY_PATH=data/local/restaurant_registry.sqlite3
CASHCO_CONFIG_FOLDER_ID=
CASHCO_PROCESSED_FOLDER_ID=
CASHCO_PARTNERS_FOLDER_ID=
CASHCO_DOCUMENTS_FOLDER_ID=
CASHCO_AUDIT_FOLDER_ID=
CASHCO_DOCUMENT_REGISTRY_PATH=data/local/document_registry.sqlite3
CASHCO_EMAIL_REGISTRY_PATH=data/local/email_registry.sqlite3
CASHCO_AUTHORIZATION_REGISTRY_PATH=data/local/authorization_registry.sqlite3
CASHCO_PAYMENT_REGISTRY_PATH=data/local/payment_registry.sqlite3
CASHCO_PERIOD_LOCK_REGISTRY_PATH=data/local/period_lock_registry.sqlite3
CASHCO_PROCESSED_DATA_PATH=data/processed
CASHCO_SOURCE_REGISTRY_PATH=data/local/source_registry.sqlite3
# GOOGLE_SERVICE_ACCOUNT_JSON must be supplied as a Codespaces/hosting secret.
CASHCO_TEST_EMAIL_RECIPIENT=
# Email delivery is separately gated in backend code. Safe defaults are mandatory.
CASHCO_EMAIL_DEFAULT_MODE=OFF
CASHCO_EMAIL_ALLOW_DRAFTS=false
CASHCO_EMAIL_ALLOW_SEND=false
CASHCO_PRODUCTION_EMAIL_SEND_ENABLED=false
CASHCO_GMAIL_AUTH_MODE=NOT_CONFIGURED
CASHCO_GMAIL_SENDER_EMAIL=
CASHCO_EMAIL_WORKFLOW_REGISTRY_PATH=data/local/email_workflow_registry.sqlite3
